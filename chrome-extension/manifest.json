{
  "manifest_version": 3,
  "name": "Leighton's Isensix Tools",
  "version": "0.1.1",
  "description": "Calibration workflow tools for Isensix.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.isensix.com/*",
    "https://app.paylocity.com/*",
    "https://webtime2.paylocity.com/*",
    "https://flat-tree-380f.leightonsolo.workers.dev/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.isensix.com/arms/admin/", "https://*.isensix.com/arms/debug/debug.php", "https://*.isensix.com/arms/debug/debug_query.php"],
      "js": ["scripts/ARMSDebugQuery.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.isensix.com/arms2/index.php*", "https://*.isensix.com/arms2/", "https://*.isensix.com/arms/", "https://*.isensix.com/arms/index.php*", "https://*.isensix.com/guardian/index.php*", "https://*.isensix.com/guardian/", "https://*.isensix.com/guardian//index.php*"],
      "js": ["scripts/CalibrateButtonsOnLiveView.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.isensix.com/arms2/calibration/calreport.php*", "https://*.isensix.com/guardian/calibration//calreport.php*", "https://*.isensix.com/arms2/calibration//calreport.php*", "https://*.isensix.com/arms2/calsetup.php?*", "https://*.isensix.com/arms/calsetup.php?*", "https://*.isensix.com/arms/calreport.php?*"],
      "js": ["compatibility.js", "scripts/AutocloseCalibrationTabs.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.isensix.com/arms/admin/index.php*mode=11*", "https://*.isensix.com/arms2/calibration/calsensor.php*", "https://*.isensix.com/arms/calsensor.php*", "https://*.isensix.com/arms2/calsensor.php*", "https://*.isensix.com/guardian/calibration/calsensor.php?id=*"],
      "js": ["compatibility.js", "scripts/AutofillTimes&Readings.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.isensix.com/arms2/index.php*", "https://*.isensix.com/arms2/", "https://*.isensix.com/arms/", "https://*.isensix.com/arms/index.php*", "https://*.isensix.com/arms/calreport.php?*", "https://*.isensix.com/arms2/calibration/calreport.php*", "https://*.isensix.com/guardian/calibration/calreport.php*", "https://*.isensix.com/guardian/calibration//calreport.php*", "https://*.isensix.com/guardian/iserep1.php*", "https://*.isensix.com/guardian/index.php*", "https://*.isensix.com/guardian/", "https://*.isensix.com/arms2/calibration//calreport.php*", "https://*.isensix.com/arms2/calsetup.php*", "https://*.isensix.com/arms/calsetup.php*", "https://*.isensix.com/arms2/iserep1.php*", "https://*.isensix.com/arms/iserep1.php*", "https://*.isensix.com/arms/debug/debug_query.php*"],
      "js": ["compatibility.js", "scripts/CalibratedCheckmarks.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.isensix.com/arms/admin/sensorcal.php"],
      "js": ["scripts/CalibrationCatcherARMS.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.isensix.com/arms2/calibration/calsensor.php?*", "https://*.isensix.com/arms/calsensor.php?*", "https://*.isensix.com/arms2/calsensor.php?*", "https://*.isensix.com/guardian/calibration/calsensor.php?id=*"],
      "js": ["scripts/CalibrationCatcherGuardian.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.isensix.com/cust/?id=*", "https://*.isensix.com/arms2/full_calreport.php", "https://*.isensix.com/guardian/full_calreport.php"],
      "js": ["scripts/calReportChecking.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.isensix.com/arms2/media/photo_manager.php*", "https://*.isensix.com/arms2/calibration/calsensor.php*", "https://*.isensix.com/arms/admin/index.php?mode=11&certs=1*", "https://*.isensix.com/arms/admin/editcalcert.php*", "https://*.isensix.com/arms/admin/sensorcal.php", "https://*.isensix.com/arms2/admin/index.php?mode=SETUP_CERT*", "https://*.isensix.com/arms/admin/index.php?mode=SETUP_CERT*", "https://*.isensix.com/arms2/calsensor.php?id=*", "https://*.isensix.com/arms/calsensor.php?id=*", "https://*.isensix.com/guardian/media/photo_manager.php*"],
      "js": ["compatibility.js", "scripts/certSelector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.isensix.com/arms2/iserep1.php", "https://*.isensix.com/arms/iserep1.php", "https://*.isensix.com/guardian/iserep1.php*"],
      "js": ["scripts/CopySummaryGuardian.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.isensix.com/arms2/calsetup.php", "https://*.isensix.com/arms2/calibration/calsensor.php*", "https://*.isensix.com/arms2/calsensor.php*", "https://*.isensix.com/arms/calsensor.php*", "https://*.isensix.com/arms/calreport.php?*", "https://*.isensix.com/arms/admin/index.php?*", "https://*.isensix.com/guardian/calibration/calsensor.php*"],
      "js": ["compatibility.js", "scripts/LastCalibrationsTable.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.isensix.com/arms2/calibration/calreport.php", "https://*.isensix.com/arms/iserep1.php", "https://*.isensix.com/arms2/iserep1.php", "https://*.isensix.com/arms/debug/debug_query.php", "https://*.isensix.com/guardian/iserep1.php"],
      "js": ["scripts/LatestCalibrationTimes.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.paylocity.com/Expense/dashboardV2/reports*", "https://webtime2.paylocity.com/webtime/Employee/Timesheet"],
      "js": ["scripts/PaylocityTools.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.isensix.com/guardian/calibration/calsensor.php*", "https://*.isensix.com/guardian/calibration/calsensor.php*", "https://*.isensix.com/arms2/calibration/calsensor.php*", "https://*.isensix.com/arms/calibration/calsensor.php*", "https://*.isensix.com/guardian/calibration/calreport.php*", "https://*.isensix.com/arms2/calibration/calreport.php*", "https://*.isensix.com/arms2/calsetup.php*", "https://*.isensix.com/arms/calsetup.php*", "https://*.isensix.com/guardian/iserep1.php*", "https://*.isensix.com/arms2/iserep1.php*", "https://*.isensix.com/arms/iserep1.php*", "https://*.isensix.com/arms2/calibration/calsensor.php*", "https://*.isensix.com/arms/admin/sensorcal.php", "https://*.isensix.com/arms/debug/debug_query.php*"],
      "js": ["compatibility.js", "scripts/sendToDatabase.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.isensix.com/arms2/calibration/calsensor.php*", "https://*.isensix.com/arms/calsensor.php*", "https://*.isensix.com/guardian/calibration/calsensor.php*", "https://*.isensix.com/arms2/calsensor.php*", "https://*.isensix.com/arms/admin/index.php?mode=11&id=*", "https://*.isensix.com/arms2/index.php*", "https://*.isensix.com/arms2/iserep1.php"],
      "js": ["compatibility.js", "scripts/TimeoutWarning.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Leighton's Isensix Tools",
    "default_popup": "popup.html"
  }
}
