function hasHelp(dom){if('undefined'==typeof dom)dom=document;return $('[data-helpid]',dom).length;}
function addHelpPanel(){var hpanel=$('#helppanel');hpanel.detach().prependTo('#outer');$('#pageid',$('#helppanel')).html($('body').data('pageid'));addHelp();}
function setHelpVal(data){$('#longhelp').val(data.long_help);$('#subject').val(data.short_help);}
function editHelp(id){$.ajax({method:'post',url:rootdir()+'/ajax/get_pagehelp.php',data:{pageid:$('#pageid').text(),topicid:id},dataType:"json"}).done(function(data){setHelpVal(data);$('[data-helpid]').removeClass('shadow blink');$('[data-helpid="'+id+'"]').each(function(nr,elem){$(elem).addClass('shadow blink');})})}
function addHelp(){$('[data-helpid]').each(function(nr,elem){var txt=$(elem).data('helpid');if($('select#hid  option[value="'+txt+'"]').length==0){$('select#hid').append($('<option value="'+txt+'">'+txt+'</option>'));}});var pageid=$('body').data('pageid');$('select#hid').append('<option selected="selected" value="'+pageid+'">* Page Help *</option>');editHelp(pageid);}
function saveHelp(e){var pageid=$('#pageid').text();var topicid=$('select#hid').val();var headline=$('#subject').val();var helptext=$('#longhelp').val();$.ajax({method:'post',url:rootdir()+'/ajax/set_pagehelp.php',data:{pageid:pageid,topicid:topicid,headline:headline,helptext:helptext},}).done(function(data){var bgcolor=$('#helppanel').css('backgroundColor');var color='#AFA';if(typeof data=='object'){setHelpVal(data);}
else{mbeep();color='#FAA'}
$("#helppanel").animate({backgroundColor:color},500).animate({backgroundColor:bgcolor},100);})}
function showPageHelp(){var pageid=$('body').data('pageid');$.ajax({method:'post',url:rootdir()+'/ajax/get_pagehelp.php',data:{pageid:pageid,topicid:pageid,},dataType:"json"}).done(function(data){data.long_help="\n"+data.long_help.replace(/ROOTDIR/g,rootdir());data.long_help=data.long_help.replace(/\n#(.+?)#/g,'\n\n<b>$1</b>');data.long_help=data.long_help.replace(/\n-(.+?)-/g,'\n\n<b>$1</b>');data.long_help=data.long_help.replace(/\n/g,'<br />');data.long_help=data.long_help.replace(/Link to (Isensix Sensor Offering) Doc/,'<a href="#" onclick="pop_pdf_isxoff()">$1</a>');data.long_help=data.long_help.replace(/Link to (Guardian Hardware Troubleshooting) Doc/,'<a href="#" onclick="pop_pdf_ght()">$1</a>');data.long_help=data.long_help.replace(/Link to (ARMS Hardware Troubleshooting) Doc/,'<a href="#" onclick="pop_pdf_aht()">$1</a>');var icons=["online","Wrench","Terminate","secicon","date","host","information","document","battery","zone_minus","zone_plus","noconnect","attachment","comment","flag_red","copy","arrow_right","error","printer","power","alarm","ok","camera","map","pdf","calibrate","alerts_off","alerts_on","noevents","evtlist","alert","table","graph","pdf"];for(var i=0;i<icons.length;i++){var search="ICON_"+icons[i].toUpperCase();var replace='<span class="bgicon ico_'+icons[i]+'">&#160;</span>';data.long_help=data.long_help.replace(search,replace);data.long_help=data.long_help.replace(search,replace);data.long_help=data.long_help.replace(search,replace);}
var content='<div class="onlinehelp">';content=content+'<h3 style="border-bottom:1px dotted gray"   >'+data.short_help+'</h3>';content=content+data.long_help;popup_content(content,'Page Help');})}
function showGeneratedPageHelp(){var pageid=$('body').data('pageid');$.ajax({method:'post',url:rootdir()+'/ajax/get_pagehelp.php',data:{pageid:pageid,topicid:''},dataType:"json"}).done(function(data){var html='<div>';var links='';var i=0;for(i=0;i<data.length;i++){if(i)links=links+'<li><a onclick="setTimeout(recenterPopup,10);" href="#h'+i+'">'+data[i].short_help+'</a></li>';html=html+'<h3 style="border-top:1px dotted gray"><a  name="h'+i+'" ></a>'+data[i].short_help+'</h3>';html=html+data[i].long_help;html+="</hr>";if(!i)html+="LINKS_HERE";}
html=html.replace(/ROOTDIR/g,rootdir());html=html.replace(/LINKS_HERE/g,'<ul class="navigation" style="border-bottom:3px solid gray;border-top:3px solid black">'+links+'</ul>');popup_content('<div id="helpdiv">'+html+'</div>','Page Help');})};