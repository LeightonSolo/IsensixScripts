function printToPdf(tableid)
{var table=getTableHTML(tableid);table=table.replace(/^\s+|\s+$/g,' ');$.fileDownload(rootdir()+'tableToPdf.php?'+guardid(),{preparingMessageHtml:i18n_translate("We are preparing your report, please wait..."),failMessageHtml:i18n_translate("There was a problem generating your report, please try again."),httpMethod:"POST",contentType:"application/x-www-form-urlencoded;charset=utf-8",encodeHTMLEntities:false,data:{'data':urlencode(table)}});}
