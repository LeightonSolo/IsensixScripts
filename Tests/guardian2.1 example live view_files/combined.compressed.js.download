function Ajax_Request(myurl){$.ajax({url:myurl});}
function updateAP(sid,obj){var fname=obj.name;var value=obj.value;if($(obj).is(':checkbox')){value=$(obj).prop('checked')?1:0;}
comment=prompt('Enter reason ','no comment');if(comment==null){var checkboxID=$(this).attr("ref");var checkbox=$('#'+checkboxID);if(checkbox.is(":checked")){checkbox.removeAttr("checked");}else{checkbox.attr("checked","true");}
$(this).parent().children().toggleClass("checked");document.body.style.cursor='default';return true;}
var url=ajaxdir()+"update_sensor_settings.php?aid="+sid;url=url+";fname="+urlencode(fname);url=url+";value="+urlencode(value);url=url+";comment="+urlencode(comment);$.post(url,function(data){appendInfo(data);});return true;}
