var url=ajaxdir()+"update_sensor_settings.php?sid="+sid;url=url+";fname="+urlencode(fname);url=url+";value="+urlencode(value);url=url+";comment="+urlencode(comment);$.post(url,function(data){appendInfo(data);});return true;}
