function pop_map(mapid,sid){var name=getSensorName(sid);return asyncpopup(pref+'media/mapview.php?all=1;svgonly=1;map='+mapid+';sid='+sid,',ap','Map #'+mapid+' Sensor '+name,'auto','auto');}
function pop_photo_id(id){return asyncpopup(pref+'media/viewphoto.php?id='+id,'map',sprintf(_T('Photo #%d'),id),'50%','auto');}
function pop_photo(sid){var name=getSensorName(sid);return asyncpopup(pref+'media/viewphoto.php?sid='+sid,'map',_T('Sensor')+' '+name+' '+_T('Photo'),'50%','auto');}
function pop_cert(id){return loadPagePartPopup(pref+'media/viewcert.php?id='+id,'map',_T('Calibration Certificate')+' '+id,800,'auto');}
function pop_document_full(id,txt){var tit='Document #'+id;;if(typeof txt!=='undefined'){tit=txt+"("+id+")";}
return loadPagePartPopup(pref+'media/viewdoc.php?id='+id,'map',tit,'FULL');}
function pop_document(id,txt){var tit='Document #'+id;;if(typeof txt!=='undefined'){tit=txt+"("+id+")";}
return loadPagePartPopup(pref+'media/viewdoc.php?id='+id,'map',tit,1024,800);}
function pop_pdf(url){return loadPagePartPopup(pref+'media/viewpdf.php?url='+urlencode(url),'pdf','Portable Document',1024,800);}
function pop_pdf_isxoff(){return pop_pdf(pref+'help/isx2017_sensor_offering.pdf');}
function pop_pdf_ght(){return pop_pdf(pref+'help/GuardianHardwareTroubleshooting.pdf');}
function pop_pdf_aht(){return pop_pdf(pref+'help/ARMSHardwareTroubleshooting.pdf');}
function pop_security(sid){return lppp(pref+'security.php?id='+sid,'sec','Sensor #'+sid+' Security Log',750,'auto');}
function pop_graph_edi_range(sid,ts,d){return asyncpopup(pref+'ajax/sensorgraph.php?w=600;h=300;id='+sid+';d='+d+';sd='+ts,'ca','Sensor #'+sid+' Graph',660,430);}
function pop_graph_edi_signal(sid){return lppp(pref+'ajax/sensorgraph.php?w=600;h=300;id='+sid+';signal=2','ca','Sensor #'+sid+' Signal Graph',660,430);}
function pop_graph_edi(sid,eid){var txt='Graph Sensor #'+sid;if(eid>0)
txt+=' Event #'+eid;return lppp(pref+'ajax/sensorgraph.php?w=600;h=350;id='+sid+';eid='+eid,'ca',txt,'auto','auto');}
function pop_select_photo(sid,pid){return lppp(pref+'media/imagedb.php?select='+sid+';pid='+pid,'imgdb','Assign Photo',600,600);}
function pop_del_user(uid){return lppp(pref+'users.php?m=d;id='+uid,'delUser',_T('Delete this User ?'),600,450);}
function pop_view_user(uid){return pop_ci(uid);}
function pop_view_profile(id){return lppp(pref+'tpdetail.php?id='+id,'tprofile','Profile #'+id+' Detail',800,'auto');}
function pop_version(){return lppp(pref+'version.php','cpy',_T('About Guardian'),800,'50%');}
function pop_create_checkpoint(z){return lppp(pref+'checkpointing/addzonecheckpt.php?last=1;z='+z,'addnch',_T('Checkpoint'),'80%','60%');}
function pop_last_checkpt(z){return lppp(pref+'checkpointing/viewcheckpoint.php?last=1;z='+z,'chprpt',_T('Checkpoint'),800,'50%');}
jQuery.fn.progressreport=function(total,amount,label,barclass){if(isNaN(total))
total=0;if(isNaN(amount))
amount=0;if(typeof barclass==='undefined'){var barclass='';}else{barclass=' '+barclass;}
var percent=Math.round(((amount / total)*100),2);if(isNaN(percent))
percent=0;var percentlabel=percent;if(percentlabel<1){percentlabel='less than 1';}
var displaytotal=total;if(displaytotal>1000000000){displaytotal=(Math.round((displaytotal / 1000000000)*Math.pow(10,2))/ Math.pow(10,2)).toFixed(2)+' billion';}else{if(displaytotal>1000000){displaytotal=(Math.round((displaytotal / 1000000)*Math.pow(10,2))/ Math.pow(10,2)).toFixed(2)+' million';}else{displaytotal=format_number(displaytotal,2,'.',',');}}
var displayamount=amount;if(displayamount>1000000000){displayamount=(Math.round((displayamount / 1000000000)*Math.pow(10,2))/ Math.pow(10,2)).toFixed(2)+' billion';}else{if(displayamount>1000000){displayamount=(Math.round((displayamount / 1000000)*Math.pow(10,2))/ Math.pow(10,2)).toFixed(2)+' million';}else{}}
label=label.replace('%1',displaytotal);label=label.replace('%2',displayamount);label=label.replace('%3',percentlabel);return this.each(function(){$(this).html(' '+label+' ');if(percent>100){percent=100;}else{if(percent<1){percent=1;}}
$(this).children('.barwrap').children('.bar').animate({width:percent+'%'},3000);});};function confirmDelete(txt,url){$('#cover').show();$('<div></div>').appendTo('body').html('<div class="c"><img src="'+pref+'/images/warning_arrow.png" alt="warning" /><br /><em class="b">'+sprintf(_T("Delete %s"),txt)+' ?</em></div>').dialog({modal:true,title:'Are you sure ?',zIndex:10000,autoOpen:true,width:400,height:300,resizable:false,position:{my:'center',at:'center',of:window.top},buttons:{No:function(){$(this).dialog("close");},Yes:function(){gotourl(url);$(this).dialog("close");}},close:function(event,ui){$('#cover').hide();$(this).remove();}});}
function gotoASK(txt,url){$('#cover').show();$('<div></div>').appendTo('body').html('<div class="c"><img src="'+pref+'/images/warning_arrow.png" alt="warning" /><br /><em class="b">'+txt+' </em></div>').dialog({modal:true,title:'Are you sure ?',zIndex:10000,autoOpen:true,width:400,height:300,resizable:false,position:{my:'center',at:'center',of:window.top},buttons:{No:function(){$(this).dialog("close");},Yes:function(){gotourl(url);$(this).dialog("close");}},close:function(event,ui){$('#cover').hide();$(this).remove();}});}
function confirmWithPost(id,txt,command,url,success){$('<div style="margin:0 auto;"></div>').appendTo('body').html('<div><form id="frmPost" method="post" action="'+url+'"><strong>'+txt+'</strong><br/><br/><hr style="width:300px" style="margin:0 auto"/><br/>Comments:<br/><textarea  id="POST_COMMENTS" class="required p100" rows="4" cols="30" name="POST_COMMENTS" type="textbox"></textarea><div id="postErrors"></div><input name="POST_ID" type="hidden" value="'+id+'"></input><input name="POST_COMMAND" type="hidden" value="'+command+'"/></form></div>').dialog({width:400,height:'auto',modal:true,title:_T('Confirmation'),zIndex:100,autoOpen:true,resizable:false,buttons:{No:function(){$(this).dialog("close");},Yes:function(){var postForm=$('#frmPost');postForm.validate({errorPlacement:function(error,element){if(element.attr('name')=='POST_COMMENTS')
$('#postErrors').append(error);else
error.insertAfter(element);}});if(postForm.valid()){$.ajax({method:"POST",url:url,data:{id:id,POST_COMMAND:command,POST_COMMENTS:$('#POST_COMMENTS').val(),ISTK:$("input[name='ISTK']").val()}}).success(function(data){if('function'==typeof success){success(data);}else{mbeep();}});$(this).dialog("close");}}},open:function(event,ui){$(event.target).parent().css('position','fixed');$(event.target).parent().css('top','40px');},close:function(event,ui){$(this).remove();}});}
function confirmSubmit(txt,button){$('<div></div>').appendTo('body').html('<div class="l"><hr style="width:300px" style="margin:0 auto"/><em>'+txt+' </em></div>').dialog({modal:true,title:'Confirm?',zIndex:100,autoOpen:true,width:'auto',resizable:false,buttons:{No:function(){$(this).dialog("close");},Yes:function(){$(this).dialog("close");var buttonObj=$(button);var form=buttonObj.closest('form');form.append('<input type="hidden" name="'+buttonObj.attr("name")+'" value="'+buttonObj.attr("value")+'"></input>');form.submit();}},close:function(event,ui){$(this).remove();}});return false;}
function alertBox(txt,onClose){$('<div></div>').appendTo('body').html('<div class="c" style="padding:1em">'+txt+' </div>').dialog({modal:true,title:'Guardian',zIndex:100,autoOpen:true,width:'auto',resizable:false,buttons:{close:function(event,ui){$(this).remove();if(onClose!=null)
onClose();}}});}
function viewUser(userid){pop_view_user(userid);}
function pop_TOS(){return asyncpopup(pref+'tos.php','tos',_T('Terms of Service'),'auto','70%');}
function viewGraph(id,width,height){pop_graph_edi(id);}
function openPhotoWindow(id,name,pwidth,pheight)
{pop_photo_id(id);}
function pop_sysinfo(){lppp(pref+'media/sardataplot.php','','System',900,540);}
function pop_mevt(eids){if(eids.length==0){alertBox("No Events Selected");}
else{return lppp(pref+'multilog.php?'+eids,'logAction',_T("Log multiple Actions"),'50%','auto');}}
function lppp(url,divid,title,width,height,callback){if(isMobilePage()){console.log('mobile popup '+url+' disabled');}else{asyncpopup(url,divid,title,width,height);}}
function isMobilePage(){return(typeof is_mobile!='undefined'&&is_mobile>0);}
function svg_click(id){if(isMobilePage()){return;}
if(id.lastIndexOf('s',0)==0){return pop_sd(id.substring(1));}
else if(id.lastIndexOf('ap',0)==0){return pop_ap(id.substring(2));}}
