function hasPopup(){return 0<$("#popit").length;}
function calcHeightInPixel(h){if('undefined'==typeof h)return parseInt($(window).height()/2);if(h=='auto')return h;var val=h.toString();var pos=val.indexOf('%');if(pos>0){var sw=parseFloat($(window).height())/100.0;return parseInt(sw*parseFloat(val.substr(0,pos)))}
return parseInt(h);}
function calcWidthInPixel(w){if('undefined'==typeof w)return parseInt($(window).width()/2);if(w=='auto')return w;var val=w.toString();var pos=val.indexOf('%');if(pos>0){var sw=parseFloat($(window).width())/100.0;return sw*parseFloat(val.substr(0,pos))}
return parseInt(w);}
