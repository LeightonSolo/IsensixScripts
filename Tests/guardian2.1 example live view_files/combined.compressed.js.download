function pop_ci(id){id=parseInt(id);if(id>0){return lppp(pref+'popups/contactdetail.php?dhtml=1;id='+id,'cif',_T('Contact Detail'),'50%','50%');}}
function pop_cilist(id){return lppp(pref+'popups/contactlist.php?dhtml=1;sid='+id,'cif',_T('Contact List'),'50%','50%');}
