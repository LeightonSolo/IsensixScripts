function pop_calinfo(cid){return lppp(pref+'/calibration/caldetail.php?id='+cid,'calrep',_T('Calibration Detail'),'60%','50%');}
function getParameterByName(url,name){var match=RegExp('[?&;]'+name+'=([^;]*)').exec(url.search);return match&&decodeURIComponent(match[1].replace(/\+/g,' '));}
function pop_reqadmin(uri){var id=getParameterByName(uri,'id');if(id){uri=uri+'?id='+id;}
return lppp(pref+'/logincheck.php?redirect_to='+encodeURIComponent(uri),'logincheck',_T('Administrative Login Required'),'auto','auto');}
