function ise_handleAjaxForm(form,button){var url=$(form).attr('action');return ise_handleAjaxFormAndButton(form,url,$(button).attr('name'),$(button).val());}
function ise_handleAjaxFormAndButton(form,url,button_name,button_val){var formData=$(form).serializeArray();formData.push({name:button_name,value:button_val});$('html body').addClass('wait');var jqxhr=$.ajax({dataType:'json',type:'post',url:url,data:formData,}).done(function(json){handle_ise_JSON_response(json,form);}).fail(function(o){console.log(o);console.log(o.responseText);beep();}).always(function(){$('html body').removeClass('wait');});};"use strict";function getStyleInformation(cssclass,attribute){var cssid="css_"+cssclass;cssid=cssid.replace(/\s+/g,'_');var selcssid="#"+cssid;if(!$(selcssid).length){$('body').append('<div id="'+cssid+'" class="'+cssclass+'" style="display:none" >.</div>');}
return $(selcssid).css(attribute);}
function getCssFileFgBg(copyfrom){var bg=getStyleInformation(copyfrom,'background-color');var fg=getStyleInformation(copyfrom,'color');var rule=' { background-color:'+bg+';color:'+fg+'}';return rule;}
function createCssFileFgBg(classname,copyfrom){var bg=getStyleInformation(copyfrom,'background-color');var fg=getStyleInformation(copyfrom,'color');var rule=classname+' { background-color:'+bg+';color:'+fg+'}';$("<style>").prop("type","text/css").html(rule).appendTo("head");}
