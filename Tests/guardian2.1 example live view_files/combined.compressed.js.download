var url=ajaxdir()+"update_sensor_settings.php?sid="+sid;url=url+";fname="+urlencode(fname);url=url+";value="+urlencode(value);url=url+";comment="+urlencode(comment);$.post(url,function(data){appendInfo(data);});return true;};/*! Countdown functions */"use strict";var countdown_disabled=false;var autoreenable=0;var countdown=180;var initialCountdown=180;var refreshURL='';var page_effect=false;function updatecounter(count)
{var o=$('#counter');if(o){var sec=count%60;var min=(count-sec)/ 60;var t=min+":";if(sec<10)
t=t+"0";t=t+sec;if(min<1){t='<em >'+t+'</em>';if(sec<30&&sec>10)
wobble();}
o.html(t);}}
function toggle_countdown(){countdown_disabled=!countdown_disabled;var o=$('#counter');if(countdown_disabled){autoreenable=0;o.html("<em title=\"Will countdown in 10min again\">No Refresh</em>");}
else{refresh();}
wobble();}
function refresh()
{if(countdown_disabled){autoreenable=autoreenable+1;if(autoreenable>900){autoreenable=0;countdown_disabled=0}}
else{countdown--;updatecounter(countdown);if(countdown<=0){if($('#popup_controlcenter').length){$('#popup_controlcenter').parent().dialog('close');}
$('body').removeClass('wait');$("#cover").hide();$('#cccover').hide();$('#cccover').unbind('click');$('body').removeClass('wait');if($('#popit').length){$('#popit').fadeOut('500');$('#popit').remove();resetCountDown();return;}
if(page_effect){$('body').removeClass('wait');$('body').fadeOut('200');}
countdown=initialCountdown;if(top.location!=self.location)
top.location.href=refreshURL;else
document.location.href=refreshURL;}}}
var events_bound=false;function startCountDown(t,url){if(!events_bound){$(window).bind('scroll',resetCountDown);$(window).bind('keydown',resetCountDown);$(window).bind('click',resetCountDown);}
initialCountdown=t;countdown=t;refreshURL=url;setInterval(refresh,1000);}
function isFixed(ele,posType){var eleCheck=ele.offsetParent(),returnVal;posType=posType||"fixed";if(eleCheck.prop("tagName")==='HTML'){return false;}
returnVal=(eleCheck.css("position")!==posType)?isFixed(eleCheck):posType;return returnVal;}
function startCountDown2(t,url){initialCountdown=t;countdown=t;refreshURL=url;setInterval('refresh()',1000);}
var isAnimate=false;function wobble(){if(isAnimate)
